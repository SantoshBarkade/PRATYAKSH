# ==========================================
# INFRA LINK — Infrastructure Execution Intelligence
# Environment Configuration Template (PS26122)
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB Atlas ----
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/infralink

# ---- LLM Configuration ----
# Provider: gemini | openai
# Default model: gemini-2.5-flash
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_google_api_key_here

# ---- File Upload ----
# Max file size in bytes (default: 10MB)
UPLOAD_MAX_SIZE_MB=10

# ---- Matching Thresholds ----
# Score >= AUTO_MATCH_THRESHOLD → AUTO_MATCH
# Score >= REVIEW_THRESHOLD → REVIEW_REQUIRED
# Score < REVIEW_THRESHOLD → UNMATCHED
MATCH_AUTO_THRESHOLD=0.90
MATCH_REVIEW_THRESHOLD=0.70
