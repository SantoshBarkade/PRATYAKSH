{
  "name": "infra-link-backend",
  "version": "1.0.0",
  "description": "INFRA LINK — Infrastructure Execution Intelligence. Planning-to-Execution Bridge for SIH 2026 PS26122.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node --project tsconfig.scripts.json scripts/seed.ts",
    "seed:prototype": "ts-node --project tsconfig.scripts.json scripts/seed-prototype.ts",
    "seed:reviewer": "ts-node --project tsconfig.scripts.json scripts/seed-reviewer-demo.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.1",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.2",
    "@types/pdf-parse": "^1.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
